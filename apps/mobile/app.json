{
  "expo": {
    "name": "EventHub Check-in",
    "slug": "eventhub-checkin",
    "scheme": "eventhub-checkin",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["android", "ios"],
    "android": {
      "package": "app.eventhub.checkin",
      "permissions": ["CAMERA", "ACCESS_NETWORK_STATE"]
    },
    "ios": {
      "bundleIdentifier": "app.eventhub.checkin",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Usamos a camera para ler QR Codes de ingressos no check-in."
      }
    },
    "extra": {
      "apiUrl": "http://localhost:3001/api"
    }
  }
}
