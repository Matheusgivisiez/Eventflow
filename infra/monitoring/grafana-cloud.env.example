# Copy these values to the ignored root .env file. Do not commit real tokens.
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-<id>.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=<instance-id>
GRAFANA_CLOUD_PROMETHEUS_TOKEN=<access-policy-token-with-metrics-write-scope>

# Add these when the Loki connection details are generated in Grafana Cloud.
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-<id>.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=<instance-id>
GRAFANA_CLOUD_LOKI_TOKEN=<access-policy-token-with-logs-write-scope>
