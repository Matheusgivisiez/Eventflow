DATABASE_URL="postgresql://eventflow:eventflow@localhost:5432/eventflow?schema=public"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"
# Emite ingresso sem cobrar: so em desenvolvimento. A API recusa subir
# em producao com esta flag ligada.
PAYMENT_SIMULATION_ENABLED="false"
PAYMENT_PROVIDER="infinite_pay"
INFINITEPAY_HANDLE=""
INFINITEPAY_WEBHOOK_SECRET=""
INFINITEPAY_API_KEY=""
INFINITEPAY_BASE_URL="https://api.checkout.infinitepay.io"
# Opcional. Se ausente, a API monta automaticamente com API_URL + secret.
# INFINITEPAY_WEBHOOK_URL="https://api.example.com/api/webhooks/infinitepay?secret=..."
ORDER_RESERVATION_TTL_MINUTES="30"
JWT_ACCESS_SECRET="dev-only-access-secret-32-chars-minimum"
JWT_REFRESH_SECRET="dev-only-refresh-secret-32-chars-minimum"
JWT_RESET_SECRET="dev-only-reset-secret-32-chars-minimum"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
APP_URL="https://eventflowtickets.com.br"
API_URL="https://api.eventflowtickets.com.br"
NEXT_PUBLIC_API_URL="https://api.eventflowtickets.com.br/api"
# Deep link do Uber (botao "Uber" na pagina do evento). Sem isso o app
# do Uber pode abrir sem o destino preenchido. Gere de graca em
# https://developer.uber.com (dashboard > Create App) e cole o Client ID aqui.
NEXT_PUBLIC_UBER_CLIENT_ID=""
MERCADO_PAGO_ACCESS_TOKEN=""
QR_CODE_SECRET="dev-only-qrcode-secret-32-chars-minimum"
# Google Wallet (opcional). Sem ISSUER_ID + SERVICE_ACCOUNT_JSON o botao fica escondido.
# SERVICE_ACCOUNT_JSON aceita o JSON da service account cru ou em base64.
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=""
GOOGLE_WALLET_ISSUER_NAME="Eventflow"
# GOOGLE_WALLET_LOGO_URL="https://eventflowtickets.com.br/icons/icon-512x512.png"
RABBITMQ_URL="amqp://eventflow:eventflow@localhost:5672"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_ENDPOINT=""
AWS_S3_FORCE_PATH_STYLE="false"
AWS_S3_ASSETS_BUCKET=""
AWS_S3_ASSETS_PUBLIC_URL=""
AWS_S3_BACKUPS_BUCKET=""
CLOUDFRONT_DISTRIBUTION_ID=""
ENCRYPTION_KEY_REF=""
GOOGLE_ANALYTICS_MEASUREMENT_ID=""
META_PIXEL_ID=""
PURCHASE_EMAIL_ENABLED="true"
NOTIFICATION_RETRY_ENABLED="true"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@eventflowtickets.com.br"
OTEL_ENABLED="false"
